@model WebBanDienThoai.Models.ViewModels.ProductIndexViewModel
@using System.Globalization
﻿@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var vn = CultureInfo.GetCultureInfo("vi-VN");
    int currentPage = ViewBag.PageIndex ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string? searchId = ViewBag.SearchId as string;
    int? filterBrandId = ViewBag.BrandId as int?;

    string DefaultProductImage = "/images/productDefault.png";

    Func<int, string> getPageUrl = page => Url.Action("Index", "Product", new { pageIndex = page, brandId = filterBrandId, searchId = searchId }) ?? "#";
}

<link href="~/css/Dashboard.css" rel="stylesheet" />

<div class="product-admin-page container-fluid py-3 px-2 px-md-3">

    <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h4 mb-1 fw-semibold text-dark">Sản phẩm</h1>
            <p class="text-muted small mb-0">Quản lý danh mục, giá và tồn kho</p>
        </div>
        <a asp-action="Create" asp-controller="Product" class="btn btn-danger d-inline-flex align-items-center gap-2 px-4 shadow-sm">
            <span>Thêm sản phẩm</span>
            <img src="/images/Admin/Product/admin_add.png" alt="" width="18" height="18" />
        </a>
    </div>

    <form method="get" asp-action="Index" asp-controller="Product" class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-6 col-lg-5">
                    <label for="searchId" class="form-label small text-muted mb-1">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="searchId" name="searchId" value="@searchId" class="form-control border-start-0 ps-0" placeholder="Theo ID hoặc tên sản phẩm..." />
                    </div>
                </div>
                <div class="col-md-auto">
                    @if (filterBrandId.HasValue)
                    {
                        <input type="hidden" name="brandId" value="@filterBrandId.Value" />
                    }
                    <button type="submit" class="btn btn-outline-danger w-100 w-md-auto">Tìm</button>
                </div>
            </div>
        </div>
    </form>

    <nav class="nav nav-pills flex-nowrap gap-2 pb-2 mb-3 overflow-auto brand-filter-nav" aria-label="Lọc hãng">
        <a class="nav-link rounded-pill px-3 @(filterBrandId == null || filterBrandId <= 0 ? "active" : "")"
           href="@Url.Action("Index", "Product", new { searchId })">
            Tất cả <span class="badge bg-light text-dark ms-1">@Model.TotalProductCount</span>
        </a>
        @foreach (var brand in Model.BrandCounts)
        {
            <a class="nav-link rounded-pill px-3 @(filterBrandId == brand.brandId ? "active" : "")"
               href="@Url.Action("Index", "Product", new { brandId = brand.brandId, searchId })">
                @brand.BrandName <span class="badge bg-light text-dark ms-1">@brand.Count</span>
            </a>
        }
    </nav>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 alert-dismissible fade show" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 product-admin-table">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Sản phẩm</th>
                        <th scope="col">Giá thấp nhất</th>
                        <th scope="col">Tồn kho</th>
                        <th scope="col">Hãng</th>
                        <th scope="col">Ngày nhập</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products != null && Model.Products.Count > 0)
                    {
                        foreach (var item in Model.Products)
                        {
                            var imageUrl = string.IsNullOrWhiteSpace(item.MainImage)
                                ? DefaultProductImage
                                : (item.MainImage.StartsWith("/") ? item.MainImage : "/" + item.MainImage);

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="product-thumb rounded-3 overflow-hidden bg-light flex-shrink-0">
                                            <img src="@imageUrl"
                                                 alt="@item.Name"
                                                 loading="lazy"
                                                 onerror="this.onerror=null;this.src='@DefaultProductImage';" />
                                        </div>
                                        <div>
                                            <div class="small text-muted font-monospace">ID @item.ProductId</div>
                                            <div class="fw-semibold text-dark">@item.Name</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-medium">@item.LowestPrice.ToString("N0", vn) ₫</span>
                                </td>
                                <td>@item.TotalStock.ToString("N0", vn)</td>
                                <td><span class="text-secondary">@item.BrandName</span></td>
                                <td>
                                    <div class="small">@item.CreatedDate.ToString("dd/MM/yyyy", vn)</div>
                                    <div class="text-muted small">@item.CreatedDate.ToString("HH:mm", vn)</div>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2">Đã ẩn</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <a href="@Url.Action("Index", "ProductVariant", new { productId = item.ProductId })" class="btn btn-sm btn-light border" title="Biến thể">
                                            <img src="/images/Admin/Product/view.png" alt="" width="16" height="16" />
                                        </a>
                                        <a href="@Url.Action("Edit", "Product", new { id = item.ProductId })" class="btn btn-sm btn-light border" title="Sửa">
                                            <img src="/images/Admin/Product/edit.png" alt="" width="16" height="16" />
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                Không có sản phẩm nào phù hợp bộ lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="d-flex justify-content-center justify-content-md-end mt-4" aria-label="Phân trang">
            <ul class="pagination pagination-sm mb-0 shadow-sm rounded-3 overflow-hidden">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link border-0 px-3" href="@(currentPage > 1 ? getPageUrl(currentPage - 1) : "#")" aria-label="Trước">&laquo;</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link border-0 px-3" href="@getPageUrl(i)">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link border-0 px-3" href="@(currentPage < totalPages ? getPageUrl(currentPage + 1) : "#")" aria-label="Sau">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>

<style>
    .product-admin-page .brand-filter-nav .nav-link {
        color: #495057;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        white-space: nowrap;
        font-size: 0.9rem;
    }

    .product-admin-page .brand-filter-nav .nav-link.active {
        background: linear-gradient(135deg, #dc3545, #c82333);
        color: #fff;
        border-color: #dc3545;
        font-weight: 600;
    }

    .product-admin-page .brand-filter-nav .nav-link:not(.active):hover {
        background: #fff5f5;
        border-color: #f5c2c7;
        color: #dc3545;
    }

    .product-admin-table thead th {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #6c757d;
        border-bottom-width: 1px;
    }

    .product-admin-table tbody tr:hover {
        background-color: rgba(220, 53, 69, 0.04);
    }

    .product-thumb {
        width: 56px;
        height: 56px;
    }

    .product-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-admin-page .pagination .page-link {
        color: #dc3545;
    }

    .product-admin-page .pagination .page-item.active .page-link {
        background-color: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }

    .product-admin-page .pagination .page-item.disabled .page-link {
        color: #adb5bd;
    }
</style>
